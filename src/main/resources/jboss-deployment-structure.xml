<?xml version="1.0" encoding="UTF-8"?>
<jboss-deployment-structure xmlns="urn:jboss:deployment-structure:1.3">
    <deployment>
        <exclusions>
            <module name="javax.faces.api" slot="main"/>
            <module name="com.sun.jsf-impl" slot="main"/>
        </exclusions>
        <dependencies>
            <module name="org.postgresql" services="import"/>

            <module name="org.hibernate" export="true"/>

            <module name="jakarta.enterprise.api" export="true"/>

            <module name="jakarta.servlet.api" export="true"/>

            <module name="jakarta.faces.api" export="true"/>

            <module name="jakarta.persistence.api" export="true"/>
        </dependencies>
    </deployment>
</jboss-deployment-structure>